# Clé API gratuite (calendrier/résultats) : https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=your_token_here

# Clé API gratuite (statistiques avancées : forme, cartons, confrontations
# directes, effectifs) : https://dashboard.api-football.com/
# Optionnelle : si absente, le bot fonctionne avec le modèle de base uniquement.
API_FOOTBALL_TOKEN=your_token_here

# Optionnel : force la saison API-Football (ex: 2024 pour la saison 2024-2025).
# Par défaut, calculée automatiquement à partir de la date du jour.
# API_FOOTBALL_SEASON=2024
